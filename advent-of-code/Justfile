# Picks up AOC_TOKEN from a .env here or in a parent directory, if there is one.
set dotenv-load
set quiet
# Nushell recipes load tools/aoc.nu with `use aoc.nu`.
export NU_LIB_DIRS := justfile_directory() / "tools"

year := `date +%Y`
# Which language to run when a day has several: `just lang=go run 1`. Empty means the first file found.
lang := env("AOC_LANG", "")
# Which variant of a day to run: `just variant=blocks run 9` runs solutions/<year>/d09-blocks.<ext>.
variant := env("AOC_VARIANT", "")
# Batch recipes skip files marked `aoc: skip` near the top, unless this is set: `just all=1 check`.
all := env("AOC_ALL", "")

# List available recipes.
default:
    just --list

# Download a day's input into inputs/ (skipped if already there). Needs AOC_TOKEN.
fetch day year=year:
    #!/usr/bin/env -S nu --no-config-file
    use aoc.nu
    aoc fetch {{day}} {{year}}

# Download every day of a year, one request per second (stops at the first failure). Skips inputs already saved.
fetch-year year=year:
    #!/usr/bin/env -S nu --no-config-file
    use aoc.nu
    for day in 1..25 {
        if not (aoc input-path $day {{year}} | path exists) {
            aoc fetch $day {{year}}
            sleep 1sec
        }
    }

# Create solutions/<year>/dNN.<ext> from the template for that language.
new day ext="py" year=year:
    #!/usr/bin/env -S nu --no-config-file
    use aoc.nu
    aoc new {{day}} "{{ext}}" {{year}}

# Run a day on the real input (fetching it if needed), or on a file you pass.
# Each answer is also labelled on stderr against what answers/<year>.txt knows.
run day input="" year=year:
    #!/usr/bin/env -S nu --no-config-file
    use aoc.nu
    aoc run-day {{day}} {{year}} "{{input}}" "{{lang}}" "{{variant}}"

# Run a day's tests: doctests for Python, `#[test]` for Rust.
test day year=year:
    #!/usr/bin/env -S nu --no-config-file
    use aoc.nu
    aoc test {{day}} {{year}} "{{lang}}" "{{variant}}"

# Run a day on one example and its params: `just example 14` (first), `just example 12 3` (dNN.3). Shows expected answers.
example day k="" year=year:
    #!/usr/bin/env -S nu --no-config-file
    use aoc.nu
    aoc example {{day}} {{year}} "{{k}}" "{{lang}}" "{{variant}}"

# Python day under pdb on an example (`just debug 14 2`), or on the real input (`just debug 14 real`).
debug day k="" year=year:
    #!/usr/bin/env -S nu --no-config-file
    use aoc.nu
    aoc debug {{day}} {{year}} "{{k}}" "{{lang}}" "{{variant}}"

# One-time: create the shared Julia environment `@aoc` that .jl days run in (packages that need installing go here).
setup-julia:
    julia --startup-file=no -e 'using Pkg; Pkg.activate("aoc", shared=true); Pkg.add("DataStructures")'

# Julia REPL with a day loaded: `input` is the raw text, `lines` the parsed data. Re-`include` after edits.
jl-repl day year=year:
    #!/usr/bin/env -S nu --no-config-file
    use aoc.nu
    aoc fetch {{day}} {{year}}
    let file = aoc solution-file {{day}} {{year}} jl
    let input = aoc input-path {{day}} {{year}}
    let setup = 'include("@FILE@"); input = read("@INPUT@", String); lines = isdefined(Main, :parse_input) ? parse_input(input) : input; println("loaded @FILE@: input, lines, part_a, part_b")'
        | str replace --all '@FILE@' $file | str replace --all '@INPUT@' $input
    exec julia --startup-file=no --project=@aoc -i -e $setup

# Time one day with hyperfine (whole process, including interpreter startup).
time day year=year:
    #!/usr/bin/env -S nu --no-config-file
    use aoc.nu
    aoc time {{day}} {{year}} "{{lang}}" "{{variant}}"

# Time every day in a year in one hyperfine table.
time-year year=year:
    #!/usr/bin/env -S nu --no-config-file
    use aoc.nu
    aoc time-year {{year}} ("{{all}}" != "")

# Run every solution file in a year (every language, or only one `ext`) and label each answer.
check year=year timeout="60" ext="*":
    #!/usr/bin/env -S nu --no-config-file
    use aoc.nu
    aoc check {{year}} {{timeout}} "{{ext}}" ("{{all}}" != "")

# Record the current answer for a day's part as correct (replaces any earlier right answer).
right day part year=year: (_record day part "right" year)

# Record the current answer for a day's part as rejected by the site.
wrong day part year=year: (_record day part "wrong" year)

_record day part kind year:
    #!/usr/bin/env -S nu --no-config-file
    use aoc.nu
    aoc record {{day}} {{year}} "{{part}}" "{{kind}}" "{{lang}}" "{{variant}}"
